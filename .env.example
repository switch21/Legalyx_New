# Legalyx-CMS - Variables d'environnement Vite
# Copier ce fichier en .env.local et renseigner les valeurs

# === Supabase (requis) ===
# URL de votre projet Supabase (ex: https://xxxxx.supabase.co)
# Disponible dans : Supabase Dashboard > Settings > API > Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Clé anon publique (respecte les politiques RLS)
# Disponible dans : Supabase Dashboard > Settings > API > anon public key
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# === Google Gemini (optionnel, pour la génération de comptes-rendus IA) ===
VITE_GEMINI_API_KEY=your-gemini-api-key