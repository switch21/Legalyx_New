# Legalyx-CMS - Variables d'environnement
# Copier ce fichier en .env.local et renseigner les valeurs

# === Supabase ===
# URL de votre projet Supabase (ex: https://xxxxx.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Clé service_role (accès admin, contourne RLS)
# Disponible dans : Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# === Google Gemini (optionnel, pour la génération de comptes-rendus IA) ===
GEMINI_API_KEY=your-gemini-api-key

# === Légacy (plus utilisé avec Supabase, mais conservé pour compatibilité) ===
DATABASE_SECRET_KEY=Legalyx_Cameroun_Secret_Vault_2026_Key

# === Serveur ===
PORT=3000
NODE_ENV=development